# ==============================================================================
# NOVA - Server Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Add your Google Gemini API key (for Gemini Live Realtime Voice):
#      Get key from: https://aistudio.google.com/
#      Paste into GEMINI_API_KEY below.
# 3. Add your Groq API key (for Ultra-Fast Typed-Text Chat):
#      Get key from: https://console.groq.com/keys
#      Paste into GROQ_API_KEY below.
# 4. CRITICAL SECURITY NOTICE:
#    - NEVER commit '.env' to git (it is included in .gitignore).
#    - NEVER prefix these variables with 'VITE_' (variables with 'VITE_' are embedded
#      into the browser bundle and publicly exposed to any visitor).
#    - These keys are read ONLY by the local server/backend.
# ==============================================================================

# Google Gemini API Key (Server-Side Only - Secret, used for Gemini Live Voice Ephemeral Tokens)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Server-Side Only - Secret, used for typed-text chat streaming)
GROQ_API_KEY=your_groq_api_key_here

# Optional Groq Chat Model Identifier (Default: openai/gpt-oss-120b)
# Available models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Standalone Server Port (Default: 3001)
PORT=3001

# ==============================================================================
# Supabase PostgreSQL Database Configuration
# ==============================================================================
# 1. Create a project at https://supabase.com
# 2. Run the SQL migration in: supabase/migrations/20261024000000_nova_schema.sql
#    in your Supabase SQL Editor.
# 3. Copy Project URL and anon public key from: Project Settings -> API.
# 4. Note: VITE_SUPABASE_ANON_KEY is a public client key protected by Row Level
#    Security (RLS). NEVER put your secret service-role key in VITE_ variables!
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public API Key (Protected by RLS policies; safe for browser bundle)
# Supports both modern publishable keys (sb_publishable_...) and legacy anon keys (eyJ...)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Alternatively, you can use:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Supabase Service Role Key (SERVER-SIDE ONLY - Secret, never prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ==============================================================================
# Hindsight Cloud (Dedicated Long-Term Memory & Recall Layer)
# ==============================================================================
# Server-side only - NEVER prefix with VITE_ to keep API keys completely confidential.
# Used for selective long-term conversational memory retention, semantic recall, and reflection.
# Keeps Supabase as the source of truth for all CRUD operations.
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
